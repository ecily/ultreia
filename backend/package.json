{
  "name": "ultreia-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "npm test",
    "verify": "npm test && node --check src/app.js && node --check src/server.js && node --check src/config/env.js",
    "verify:db": "node scripts/verify-db.mjs",
    "provision:admin": "node scripts/provision-admin.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.20.0"
  }
}
