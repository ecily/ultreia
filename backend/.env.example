ULTREIA_MODE=local
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
MONGODB_URI=
MONGODB_DB_NAME=ultreia_production
LOG_LEVEL=info

# Expo / Android push. Values stay outside Git.
EXPO_PROJECT_ID=
EXPO_ACCESS_TOKEN=

# Disabled by default. Enable only for a controlled technical test.
PUSH_TEST_ENABLED=false
PUSH_TEST_KEY=
HEARTBEAT_TTL_SECONDS=604800
DIAGNOSTIC_TTL_SECONDS=2592000
